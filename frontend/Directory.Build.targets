<Project>
  <PropertyGroup>
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <CppWinRTPath>Y:\.nuget\packages\microsoft.windows.cppwinrt\2.0.230706.1\bin\</CppWinRTPath>
    <ReactNativeWindowsDir Condition="'$(ReactNativeWindowsDir)' == ''">$(MSBuildThisFileDirectory)node_modules\react-native-windows\</ReactNativeWindowsDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <MultiProcessorCompilation>false</MultiProcessorCompilation>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- ReferencePath to source-build WinMD removed.
       Using NuGet package (UseExperimentalNuget=true) which provides Microsoft.ReactNative.winmd automatically. -->
  <Target Name="_CppWinRTCleanMakeReferenceProjectionOutputs" />
  <Target Name="CopyPrebuiltPriFiles" BeforeTargets="_GenerateProjectPriFileCore">
    <!-- Intentionally left blank: NuGet package supplies Microsoft.ReactNative.pri -->
  </Target>
  <Target Name="FilterPayloadOutputs"
          BeforeTargets="_GenerateProjectPriFileCore;_CalculateInputsForGenerateProjectPriFileCore;_GenerateProjectPriConfigurationFiles;_GetPackageOutputs;_ValidatePayloadFiles"
          AfterTargets="_ComputeInputPriFiles;_GetPriFilesFromPayload">
    <ItemGroup>
      <!-- 1. Remove non-existent items from all payload and PRI item groups -->
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="!Exists('%(Identity)')" />
      <_PriFilesFromPayloadRaw Remove="@(_PriFilesFromPayloadRaw)" Condition="!Exists('%(Identity)')" />
      <_PriFilesFromPayload Remove="@(_PriFilesFromPayload)" Condition="!Exists('%(Identity)')" />
      <_PriFile Remove="@(_PriFile)" Condition="!Exists('%(Identity)')" />
      <_PriFileToMerge Remove="@(_PriFileToMerge)" Condition="!Exists('%(Identity)')" />

      <!-- 2. Remove duplicate PRI and payload files originating from react-native-windows target and build directories -->
      <_PriFileToMerge Remove="@(_PriFileToMerge)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/target/'))" />
      <_PriFileToMerge Remove="@(_PriFileToMerge)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/build/'))" />

      <_PriFilesFromPayload Remove="@(_PriFilesFromPayload)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/target/'))" />
      <_PriFilesFromPayload Remove="@(_PriFilesFromPayload)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/build/'))" />

      <_PriFilesFromPayloadRaw Remove="@(_PriFilesFromPayloadRaw)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/target/'))" />
      <_PriFilesFromPayloadRaw Remove="@(_PriFilesFromPayloadRaw)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/target/'))" />

      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/target/'))" />
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/build/'))" />

      <_PriFile Remove="@(_PriFile)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/target/'))" />
      <_PriFile Remove="@(_PriFile)" Condition="$([System.String]::Copy('%(Identity)').Replace('\','/').ToLower().Contains('react-native-windows/build/'))" />
    </ItemGroup>
  </Target>
</Project>
